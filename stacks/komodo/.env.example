# Kopieren nach .env (nicht im Git). Passwörter mit openssl rand erzeugen.
DOMAIN=hl.mehrwert.icu
TZ=Europe/Berlin

# Datenbank (MongoDB)
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=

# Core
KOMODO_TITLE=Homelab
KOMODO_HOST=https://komodo.hl.mehrwert.icu
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=
KOMODO_JWT_SECRET=
KOMODO_WEBHOOK_SECRET=
# Erster Server = dieser Host (Periphery im selben Compose-Netz)
KOMODO_FIRST_SERVER_NAME=docker01
KOMODO_FIRST_SERVER_ADDRESS=https://periphery:8120
# Core verifiziert Periphery über diesen Public Key (geteiltes Volume)
KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub
