# frp-Client: baut die Verbindung vom Heimnetz zum öffentlichen VPS auf
# (Home hängt hinter CGNAT, deshalb kein Port-Forwarding möglich).
# Nach frpc.toml kopieren und Server/Token eintragen.
serverAddr = "<VPS-IP-oder-DNS>"
serverPort = 7000
auth.method = "token"
auth.token = "<FRP_TOKEN>"

# TLS-Terminierung bleibt zu Hause (Traefik); der Tunnel reicht nur 80/443 durch.
[[proxies]]
name = "web"
type = "tcp"
localIP = "192.168.181.100"
localPort = 80
remotePort = 80

[[proxies]]
name = "websecure"
type = "tcp"
localIP = "192.168.181.100"
localPort = 443
remotePort = 443
