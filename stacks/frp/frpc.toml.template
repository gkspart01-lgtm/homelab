# frp-Client — wird von Komodo aus komodo/homelab.toml erzeugt (config_files),
# damit Adresse/Token/Domain nicht im Repo stehen.
# frp-panel-Stil: der Token gehoert in die Metadaten, nicht in auth.token
# (auth.token -> "token in login doesn't match", ohne Token -> "user or meta token can not be empty")
user = "[[FRP_USER]]"
serverAddr = "[[FRP_SERVER_ADDR]]"
serverPort = 7001
metadatas.token = "[[FRP_TOKEN]]"
log.to = "console"
log.level = "info"

# Der VPS terminiert TLS (Let's Encrypt auf :443) und reicht Klartext an frps weiter.
# Deshalb lokaler Port = Traefik-HTTP. ACHTUNG: Traefik leitet :80 auf :443 um —
# für den Tunnel braucht es einen eigenen, nicht umleitenden Entrypoint (siehe README).
# TCP-Proxy: der VPS-Traefik terminiert TLS und leitet auf remotePort 8082 weiter.
# Lokal zeigt der Tunnel auf den nicht umleitenden Entrypoint (:8080).
[[proxies]]
name = "hl-web"
type = "tcp"
localIP = "192.168.181.100"
localPort = 8080
remotePort = 8082
