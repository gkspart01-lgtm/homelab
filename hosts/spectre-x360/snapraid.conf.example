# /etc/snapraid.conf - Beispiel fuer gemischte USB-Platten (0,5-8 TB).
# Regel: die Paritaetsplatte muss MINDESTENS so gross sein wie die groesste Datenplatte.
# Deshalb: die 8-TB-Platte wird Paritaet, die uebrigen sind Daten.
# 2.5"-Platten ohne eigenes Netzteil NUR an einem aktiven USB-Hub betreiben.

# Paritaet
parity /srv/parity/snapraid.parity

# Inhaltsdatei (auf einem beschreibbaren Daten-Pool)
content /srv/pool/snapraid.content
content /srv/parity/snapraid.content

# Daten-Plaetten (je Platte ein eigenes Dateisystem, kein Striping!)
# Mountpoints nach UUID in /etc/fstab, siehe docs/02-speicher.md
data d1 /mnt/disk1
data d2 /mnt/disk2
data d3 /mnt/disk3
data d4 /mnt/disk4
data d5 /mnt/disk5

# mergerfs-Pool (die EINZIGE Freigabe fuer Dienste): /srv/pool
# HINWEIS: /mnt/diskX und /srv/pool duerfen sich nicht ueberlagern (mergefs-Excludes).

exclude *.unrecoverable
exclude /tmp/
exclude /lost+found/
exclude /srv/pool/snapraid.content
exclude *.bak
exclude .Trash-*

# Anzahl zugelassener geloeschter Dateien (Sicherheitsnetz gegen Massenloeschen)
# Deaktiviert - SnapRAID soll immer syncen duerfen:
# nohidden
