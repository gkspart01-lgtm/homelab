# /root/.restic-env (chmod 600) - wird vom restic-backup.service gelesen.
# restic-Ziel: IONOS Object Storage (S3-kompatibel) oder Hetzner Storage Box.
# Dieses Beispiel ist KEIN Secret-File fuer Git - der Inhalt bleibt auf dem Host.
RESTIC_REPOSITORY=s3:https://s3.<region>.ionos.com/<bucket>/homelab
RESTIC_PASSWORD=<restic-passwort-lang-und-zufaellig>
AWS_ACCESS_KEY_ID=<ionos-s3-key>
AWS_SECRET_ACCESS_KEY=<ionos-s3-secret>
# Alternativ per SFTP/Storage Box:
# RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:/backups/homelab
# RESTIC_PASSWORD=<...>
