# Answer-File fuer die unbeaufsichtigte Proxmox-VE-Installation auf dem
# Zielhost (HP Spectre x360 13-ae). Fuer den Disaster-Recovery-Fall:
# ISO damit backen, USB-Stick schreiben, Host installiert sich selbst.
#
#   proxmox-auto-install-assistant prepare-iso proxmox-ve_9.2-1.iso \
#     --fetch-from iso --answer-file answer-file.toml --output hl0-auto.iso
#
# WICHTIG (aus den Fallen des Testaufbaus):
#   * reboot-mode = "power-off" + ISO vor dem Start abziehen,
#     sonst installiert der Rechner in einer Schleife immer wieder neu.
#   * root-ssh-keys schon hier setzen, dann ist der Host sofort per SSH erreichbar.
#   * source = "from-dhcp": die statische IP setzt pve-bootstrap.sh danach.
[global]
keyboard = "de"
country = "de"
fqdn = "hl0.mehrwert.icu"
mailto = "mail@no.invalid"
timezone = "Europe/Berlin"
root-password = "BITTE-AENDERN"
root-ssh-keys = [
    "ssh-ed25519 AAAA...DEIN-PUBLIC-KEY bitte-eintragen",
]
reboot-mode = "power-off"

[network]
source = "from-dhcp"

[disk-setup]
# "sda" = die verbaute M.2-NVMe (bei nur einer Platte immer sda).
# Kein ZFS: 16 GB RAM sind knapp, LVM-Thin reicht fuer VM/LXC-Disks.
filesystem = "ext4"
disk-list = ["sda"]
